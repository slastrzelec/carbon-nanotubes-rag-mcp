# Copy to .env (git-ignored) and fill in locally. Never commit .env.

# Used only by the RAG backend container (docker-compose.backend.yml) for /query.
# The MCP server itself never reads it.
OPENAI_API_KEY=

# MCP server settings (optional; defaults shown)
RAG_MCP_BACKEND_URL=http://127.0.0.1:8000
RAG_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
RAG_MCP_ASK_PER_MINUTE=6
RAG_MCP_ASK_PER_DAY=100
RAG_MCP_FREE_PER_MINUTE=30
